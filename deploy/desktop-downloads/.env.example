# Copy this file to .env in this directory. Never commit .env.

TZ=Australia/Perth
LAN_BIND_IP=192.168.0.141
DOWNLOAD_ROOT=D:/Downloads

PUID=1000
PGID=1000

# Management interfaces are published only on LAN_BIND_IP. The peer port is an
# AirVPN reservation allowed on tun0; it is not published on the Windows host.
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_PEER_PORT=40564
FIREFOX_HTTPS_PORT=3001
FIREFOX_USERNAME=replace_with_a_local_username
FIREFOX_PASSWORD=replace_with_a_long_random_password

# Pinned images. Review release notes before changing these values.
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.3
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.4_v2.0.15-ls479
FIREFOX_IMAGE=lscr.io/linuxserver/firefox:1157.0build1-1xtradeb1.2404.1-ls126

# Native AirVPN WireGuard connection. Copy these values from the generated
# AirVPN configuration. Use only its IPv4 Address/CIDR; IPv6 is disabled here.
AIRVPN_SERVER_COUNTRIES=Singapore
WIREGUARD_PRIVATE_KEY=replace_with_airvpn_private_key
WIREGUARD_PRESHARED_KEY=replace_with_airvpn_preshared_key
WIREGUARD_ADDRESSES=replace_with_airvpn_ipv4_address_and_prefix
WIREGUARD_MTU=1420
