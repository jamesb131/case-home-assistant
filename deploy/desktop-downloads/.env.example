# Copy this file to .env in this directory. Never commit .env.

TZ=Australia/Perth
LAN_BIND_IP=192.168.0.141
DOWNLOAD_ROOT=D:/Downloads

PUID=1000
PGID=1000

# Management interfaces. These are published only on LAN_BIND_IP.
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_PEER_PORT=6881
FIREFOX_HTTPS_PORT=3001
FIREFOX_USERNAME=replace_with_a_local_username
FIREFOX_PASSWORD=replace_with_a_long_random_password

# Pinned images. Review release notes before changing these values.
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.3
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.4_v2.0.15-ls479
FIREFOX_IMAGE=lscr.io/linuxserver/firefox:1157.0build1-1xtradeb1.2404.1-ls126

# Custom WireGuard connection. Obtain all values from the selected VPN provider.
# The stack intentionally cannot start without them.
VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=replace_with_private_key
WIREGUARD_ADDRESSES=replace_with_tunnel_address_and_prefix
WIREGUARD_PUBLIC_KEY=replace_with_server_public_key
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ENDPOINT_IP=replace_with_server_ip
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_MTU=1320
