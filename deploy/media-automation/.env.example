# Copy this file to .env in this directory. Never commit .env.

TZ=Australia/Perth
LAN_BIND_IP=192.168.0.141
DOWNLOAD_ROOT=D:/Downloads

# Set this to the existing directory that contains Movies, Movies 4K and
# TV Shows. Use forward slashes for Docker Desktop paths.
PLEX_MEDIA_ROOT=D:/replace_with_existing_plex_media_root

PUID=1000
PGID=1000

# Management pages are published only on LAN_BIND_IP.
RADARR_PORT=7878
RADARR_4K_PORT=7879
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696
SEERR_PORT=5055
SEERR_LOG_LEVEL=info

# Stable upstream channels. Pin these to reviewed version tags or digests if
# reproducible upgrades are preferred.
RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
BAZARR_IMAGE=lscr.io/linuxserver/bazarr:latest
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:latest
SEERR_IMAGE=ghcr.io/seerr-team/seerr:latest
